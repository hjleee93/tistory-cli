{
  "name": "tistory-cli",
  "version": "0.3.0",
  "description": "Unofficial Tistory CLI: publish Markdown posts from your terminal via browser automation",
  "keywords": [
    "tistory",
    "blog",
    "cli",
    "markdown",
    "playwright",
    "automation",
    "unofficial"
  ],
  "author": "hjleee93",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjleee93/tistory-cli.git"
  },
  "homepage": "https://github.com/hjleee93/tistory-cli#readme",
  "bugs": {
    "url": "https://github.com/hjleee93/tistory-cli/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tistory": "./bin/tistory.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    ".env.example",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "marked": "^18.1.1",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
